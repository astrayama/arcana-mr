{
  "name": "arcana-mr",
  "version": "0.1.0",
  "private": true,
  "description": "Mixed-reality tarot for self-reflection on Meta Quest 3 (WebXR, Immersive Web SDK)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "validate:cards": "tsx scripts/validate-cards.ts",
    "validate": "npm run -s validate:cards; c=$?; npm run -s validate:decks; d=$?; npm run -s validate:themes; t=$?; exit $((c|d|t))",
    "validate:decks": "tsx scripts/validate-decks.ts",
    "validate:themes": "tsx scripts/validate-themes.ts",
    "deck:rws-1909": "tsx scripts/fetch-rws-1909.ts"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.0-rc.2",
    "@iwsdk/reference": "1.0.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.0.0-rc.2",
    "@meta-quest/metavr": "^1.3.2",
    "@types/three": "^0.181.0",
    "sharp": "0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "$sharp",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
