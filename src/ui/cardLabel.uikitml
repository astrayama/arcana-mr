<!--
  Compact label lying in front of a face-up card. Card-width at scale 1, so
  it scales with the cards. Two entries: a card and the card lying across it.
  Theme template: double-brace tokens are filled from the active theme.
-->
<style>
  {{fontFaces}}

  .lb-root {
    flex-direction: column;
    align-items: stretch;
    width: 8.75;
    padding-top: 0.45;
    padding-bottom: 0.5;
    padding-left: 0.45;
    padding-right: 0.45;
    gap: 0.35;
    background-color: {{colors.panelBackground}};
    border-color: {{colors.panelBorder}};
    border-width: 0.08;
    border-radius: 0.8;
  }

  .lb-entry {
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }

  .lb-entry:hover {
    background-color: {{colors.panelBorder}};
  }

  .lb-head {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35;
  }

  .lb-position {
    {{bodyFont}}
    font-size: 0.7;
    font-weight: semi-bold;
    letter-spacing: 0.1;
    color: {{colors.panelMuted}};
  }

  .lb-rev {
    {{bodyFont}}
    font-size: 0.7;
    font-weight: semi-bold;
    letter-spacing: 0.1;
    color: {{colors.reversed}};
  }

  .lb-name {
    {{headingFont}}
    margin-top: 0.1;
    font-size: 1.0;
    font-weight: semi-bold;
    text-align: center;
    color: {{colors.panelText}};
  }
</style>
<div id="label" class="lb-root">
  <div id="lb-e1" class="lb-entry">
    <div class="lb-head">
      <div id="lb-position" class="lb-position">PAST</div>
      <div id="lb-rev" class="lb-rev" style="display: none">REVERSED</div>
    </div>
    <div id="lb-name" class="lb-name">Card name</div>
  </div>
  <div id="lb-e2" class="lb-entry" style="display: none">
    <div class="lb-head">
      <div id="lb2-position" class="lb-position">CHALLENGE</div>
      <div id="lb2-rev" class="lb-rev" style="display: none">REVERSED</div>
    </div>
    <div id="lb2-name" class="lb-name">Card name</div>
  </div>
</div>
