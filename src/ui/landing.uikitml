<!--
  Landing card shown in the flat browser view before entering the headset
  experience. Theme template: {{tokens}} are filled from the active theme.
-->
<style>
  {{fontFaces}}

  .landing-root {
    flex-direction: column;
    align-items: center;
    width: 40;
    padding-top: 3.2;
    padding-bottom: 3.2;
    padding-left: 3.2;
    padding-right: 3.2;
    background-color: {{colors.panelBackground}};
    border-color: {{colors.panelBorder}};
    border-width: 0.15;
    border-radius: {{panelRadius}};
  }

  .landing-title {
    {{headingFont}}
    font-size: 4.2;
    font-weight: semi-bold;
    color: {{colors.accent}};
  }

  .landing-sub {
    {{bodyFont}}
    margin-top: 1.2;
    font-size: 1.6;
    line-height: 1.4;
    text-align: center;
    color: {{colors.panelMuted}};
  }

  .landing-btn {
    margin-top: 2.8;
    padding-top: 1.1;
    padding-bottom: 1.1;
    padding-left: 3;
    padding-right: 3;
    border-radius: 1.4;
    background-color: {{colors.accent}};
    cursor: pointer;
  }

  .landing-btn:hover {
    background-color: {{colors.highlight}};
  }

  .landing-btn-label {
    {{bodyFont}}
    font-size: 1.8;
    font-weight: medium;
    color: {{colors.accentText}};
  }
</style>
<div id="landing" class="landing-root">
  <div class="landing-title">Arcana MR</div>
  <div class="landing-sub">A tarot reading for self-reflection. Put on your headset, then step in to lay the cards on your table.</div>
  <div id="landing-enter" class="landing-btn">
    <div class="landing-btn-label">Begin</div>
  </div>
</div>
