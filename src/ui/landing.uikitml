<!--
  Landing card shown in the flat browser view before entering the headset
  experience. Theme template: {{tokens}} are filled from the active theme.
-->
<style>
  {{fontFaces}}

  .landing-root {
    flex-direction: column;
    align-items: center;
    width: 40;
    padding-top: 3.2;
    padding-bottom: 3.2;
    padding-left: 3.2;
    padding-right: 3.2;
    background-color: {{colors.panelBackground}};
    border-color: {{colors.panelBorder}};
    border-width: 0.15;
    border-radius: {{panelRadius}};
  }

  .landing-title {
    {{headingFont}}
    font-size: 4.2;
    font-weight: semi-bold;
    color: {{colors.accent}};
  }

  .landing-sub {
    {{bodyFont}}
    margin-top: 1.2;
    font-size: 1.6;
    line-height: 1.4;
    text-align: center;
    color: {{colors.panelMuted}};
  }

  .landing-steps {
    flex-direction: column;
    gap: 1;
    margin-top: 2.2;
    width: 33;
  }

  .landing-step {
    flex-direction: row;
    align-items: center;
    gap: 1.2;
  }

  .landing-step-num {
    {{headingFont}}
    width: 2.6;
    height: 2.6;
    border-radius: 1.3;
    border-width: 0.12;
    border-color: {{colors.accent}};
    font-size: 1.4;
    text-align: center;
    color: {{colors.accent}};
  }

  .landing-step-text {
    {{bodyFont}}
    flex-shrink: 1;
    font-size: 1.4;
    line-height: 1.35;
    color: {{colors.panelText}};
  }

  .landing-privacy {
    {{bodyFont}}
    width: 34;
    margin-top: 1.8;
    font-size: 1.2;
    line-height: 1.35;
    text-align: center;
    color: {{colors.panelMuted}};
  }

  .landing-maker {
    {{headingFont}}
    margin-top: 1.6;
    font-size: 1.3;
    color: {{colors.panelMuted}};
  }

  .landing-note {
    {{bodyFont}}
    margin-top: 1.6;
    width: 33;
    font-size: 1.35;
    line-height: 1.4;
    text-align: center;
    color: {{colors.reversed}};
  }

  .landing-btn {
    margin-top: 2.8;
    padding-top: 1.1;
    padding-bottom: 1.1;
    padding-left: 3;
    padding-right: 3;
    border-radius: 1.4;
    background-color: {{colors.accent}};
    cursor: pointer;
  }

  .landing-btn:hover {
    background-color: {{colors.highlight}};
  }

  .landing-btn-label {
    {{bodyFont}}
    font-size: 1.8;
    font-weight: medium;
    color: {{colors.accentText}};
  }
</style>
<div id="landing" class="landing-root">
  <div class="landing-title">Arcana</div>
  <div class="landing-sub">Tarot for self-reflection, laid out on your own table.</div>
  <div class="landing-steps">
    <div class="landing-step">
      <div class="landing-step-num">1</div>
      <div class="landing-step-text">Open this page in the Quest Browser on Meta Quest 3.</div>
    </div>
    <div class="landing-step">
      <div class="landing-step-num">2</div>
      <div class="landing-step-text">Tap Begin, and allow the headset to see your room if it asks.</div>
    </div>
    <div class="landing-step">
      <div class="landing-step-num">3</div>
      <div class="landing-step-text">Shuffle, draw, and turn the cards with your hands.</div>
    </div>
  </div>
  <div id="landing-enter" class="landing-btn"><div class="landing-btn-label">Begin</div></div>
  <div id="landing-note" class="landing-note" style="display: none">Note</div>
  <div class="landing-privacy">Nothing you do here is recorded. Reading together sends encrypted messages through our relay, which never stores them.</div>
  <div class="landing-maker">Made by Screen Sage Studios</div>
</div>
