<!--
  Reading menu: stands at the far edge of the mat. Sections are shown or hidden
  by ReadingFlowSystem as the reading moves through its states.
  Theme template: double-brace tokens are filled from the active theme.
-->
<style>
  {{fontFaces}}

  .mn-root {
    flex-direction: column;
    align-items: center;
    width: 34;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2;
    padding-right: 2;
    background-color: {{colors.panelBackground}};
    border-color: {{colors.panelBorder}};
    border-width: 0.12;
    border-radius: {{panelRadius}};
  }

  .mn-title {
    {{headingFont}}
    font-size: 2.6;
    font-weight: semi-bold;
    color: {{colors.accent}};
  }

  .mn-status {
    {{bodyFont}}
    margin-top: 0.8;
    width: 29;
    font-size: 1.4;
    line-height: 1.35;
    text-align: center;
    color: {{colors.panelText}};
  }

  .mn-choices {
    flex-direction: row;
    gap: 1.2;
    margin-top: 1.6;
  }

  .mn-choice {
    flex-direction: column;
    align-items: center;
    width: 14.2;
    padding-top: 1.4;
    padding-bottom: 1.4;
    padding-left: 1;
    padding-right: 1;
    border-radius: 1.4;
    border-width: 0.12;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }

  .mn-choice:hover {
    border-color: {{colors.accent}};
    background-color: {{colors.panelBorder}};
  }

  .mn-choice-icon {
    width: 3;
    height: 3;
    color: {{colors.accent}};
  }

  .mn-choice-title {
    {{headingFont}}
    margin-top: 0.6;
    font-size: 1.8;
    font-weight: semi-bold;
    color: {{colors.panelText}};
  }

  .mn-choice-sub {
    {{bodyFont}}
    margin-top: 0.3;
    font-size: 1.2;
    text-align: center;
    color: {{colors.panelMuted}};
  }

  .mn-view {
    flex-direction: row;
    align-items: center;
    gap: 0.8;
    margin-top: 1.6;
  }

  .mn-view-label {
    {{bodyFont}}
    font-size: 1.2;
    color: {{colors.panelMuted}};
  }

  .mn-view-chip {
    flex-direction: row;
    align-items: center;
    gap: 0.5;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.2;
    padding-right: 1.2;
    border-radius: 1.2;
    border-width: 0.1;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }

  .mn-view-icon {
    width: 1.6;
    height: 1.6;
    color: {{colors.panelText}};
  }

  .mn-view-text {
    {{bodyFont}}
    font-size: 1.3;
    font-weight: medium;
    color: {{colors.panelText}};
  }

  .mn-primary {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    margin-top: 1.6;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 3;
    padding-right: 3;
    border-radius: 1.2;
    background-color: {{colors.accent}};
    cursor: pointer;
  }

  .mn-primary:hover {
    background-color: {{colors.highlight}};
  }

  .mn-primary-icon {
    width: 1.9;
    height: 1.9;
    color: {{colors.accentText}};
  }

  .mn-primary-text {
    {{bodyFont}}
    font-size: 1.6;
    font-weight: semi-bold;
    color: {{colors.accentText}};
  }

  .mn-link {
    flex-direction: row;
    align-items: center;
    gap: 0.5;
    margin-top: 1.2;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.2;
    padding-right: 1.2;
    border-radius: 1;
    cursor: pointer;
  }

  .mn-link:hover {
    background-color: {{colors.panelBorder}};
  }

  .mn-link-icon {
    width: 1.6;
    height: 1.6;
    color: {{colors.panelMuted}};
  }

  .mn-link-text {
    {{bodyFont}}
    font-size: 1.3;
    color: {{colors.panelMuted}};
  }
</style>
<div id="menu" class="mn-root">
  <div id="mn-title" class="mn-title">Arcana</div>
  <div id="mn-status" class="mn-status">Take a breath. When you are ready, choose a reading.</div>

  <div id="mn-choices" class="mn-choices">
    <div id="mn-single" class="mn-choice">
      <Square class="mn-choice-icon"></Square>
      <div class="mn-choice-title">Single Card</div>
      <div class="mn-choice-sub">One card to reflect on</div>
    </div>
    <div id="mn-three" class="mn-choice">
      <Columns3 class="mn-choice-icon"></Columns3>
      <div class="mn-choice-title">3-Card Spread</div>
      <div class="mn-choice-sub">Past, present, future</div>
    </div>
  </div>

  <div id="mn-view" class="mn-view">
    <div class="mn-view-label">Around you</div>
    <div id="mn-view-room" class="mn-view-chip">
      <House id="mn-view-room-icon" class="mn-view-icon"></House>
      <div id="mn-view-room-text" class="mn-view-text">Your room</div>
    </div>
    <div id="mn-view-vr" class="mn-view-chip">
      <MoonStar id="mn-view-vr-icon" class="mn-view-icon"></MoonStar>
      <div id="mn-view-vr-text" class="mn-view-text">VR</div>
    </div>
  </div>

  <div id="mn-new" class="mn-primary" style="display: none">
    <RotateCcw class="mn-primary-icon"></RotateCcw>
    <div class="mn-primary-text">New reading</div>
  </div>

  <div id="mn-move" class="mn-link">
    <Move class="mn-link-icon"></Move>
    <div class="mn-link-text">Move the mat</div>
  </div>
</div>
