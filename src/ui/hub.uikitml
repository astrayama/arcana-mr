<!--
  The main menu between readings: Home, the spread picker, the spread
  builder, Read together, Settings, How it works, and Credits. One document with a fixed
  size; HubSystem shows one page at a time. Repeated items (spread tiles,
  card backs, surroundings) are generated into the slot tokens.
  Theme template: double-brace tokens are filled from the active theme.
-->
<style>
  {{fontFaces}}

  .hb-root {
    flex-direction: column;
    width: 40;
    height: 38;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.2;
    padding-right: 2.2;
    background-color: {{colors.panelBackground}};
    border-color: {{colors.panelBorder}};
    border-width: 0.12;
    border-radius: {{panelRadius}};
  }

  .hb-page {
    flex-direction: column;
    flex-grow: 1;
  }

  .hb-center {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
  }
  .hb-title {
    {{headingFont}}
    margin-top: 0.6;
    font-size: 4.6;
    font-weight: semi-bold;
    color: {{colors.accent}};
  }
  .hb-tagline {
    {{bodyFont}}
    margin-top: 0.4;
    font-size: 1.5;
    color: {{colors.panelMuted}};
  }
  .hb-begin-row {
    flex-direction: row;
    justify-content: center;
    gap: 1.2;
    margin-top: 2.4;
  }
  .hb-begin {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1;
    width: 26;
    padding-top: 1.5;
    padding-bottom: 1.5;
    border-radius: 1.6;
    background-color: {{colors.accent}};
    cursor: pointer;
  }
  .hb-begin:hover {
    background-color: {{colors.highlight}};
  }
  .hb-begin-icon {
    width: 2.2;
    height: 2.2;
    color: {{colors.accentText}};
  }
  .hb-begin-text {
    {{headingFont}}
    font-size: 2;
    font-weight: semi-bold;
    color: {{colors.accentText}};
  }
  .hb-together-go {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.7;
    width: 14.6;
    border-radius: 1.6;
    border-width: 0.14;
    border-color: {{colors.accent}};
    cursor: pointer;
  }
  .hb-together-go:hover {
    background-color: {{colors.panelBorder}};
  }
  .hb-together-icon {
    width: 2;
    height: 2;
    color: {{colors.accent}};
  }
  .hb-together-text {
    {{headingFont}}
    font-size: 1.55;
    font-weight: semi-bold;
    color: {{colors.accent}};
  }
  .hb-newhere {
    {{bodyFont}}
    margin-top: 1.2;
    padding-top: 0.4;
    padding-bottom: 0.4;
    padding-left: 1.2;
    padding-right: 1.2;
    border-radius: 1;
    border-width: 0.1;
    border-color: {{colors.accent}};
    font-size: 1.25;
    color: {{colors.accent}};
    cursor: pointer;
  }
  .hb-newhere:hover {
    background-color: {{colors.panelBorder}};
  }
  .hb-tiles {
    flex-direction: row;
    gap: 1.1;
    margin-top: 1.6;
  }
  .hb-go {
    flex-direction: column;
    align-items: center;
    width: 11;
    padding-top: 1.3;
    padding-bottom: 1.3;
    padding-left: 0.8;
    padding-right: 0.8;
    border-radius: 1.4;
    border-width: 0.12;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }
  .hb-go:hover {
    border-color: {{colors.accent}};
    background-color: {{colors.panelBorder}};
  }
  .hb-go-icon {
    width: 2.6;
    height: 2.6;
    color: {{colors.accent}};
  }
  .hb-go-title {
    {{headingFont}}
    margin-top: 0.6;
    font-size: 1.4;
    line-height: 1.25;
    text-align: center;
    font-weight: semi-bold;
    color: {{colors.panelText}};
  }
  .hb-go-sub {
    {{bodyFont}}
    margin-top: 0.3;
    font-size: 1.05;
    line-height: 1.3;
    text-align: center;
    color: {{colors.panelMuted}};
  }
  .hb-footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 1.4;
  }
  .hb-link {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1;
    padding-right: 1;
    border-radius: 1;
    cursor: pointer;
  }
  .hb-link:hover {
    background-color: {{colors.panelBorder}};
  }
  .hb-link-icon {
    width: 1.6;
    height: 1.6;
    color: {{colors.panelMuted}};
  }
  .hb-link-text {
    {{bodyFont}}
    font-size: 1.3;
    color: {{colors.panelMuted}};
  }

  .hb-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .hb-back {
    flex-direction: row;
    align-items: center;
    gap: 0.5;
    width: 8;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 0.6;
    padding-right: 0.6;
    border-radius: 1;
    cursor: pointer;
  }
  .hb-back:hover {
    background-color: {{colors.panelBorder}};
  }
  .hb-back-icon {
    width: 1.7;
    height: 1.7;
    color: {{colors.panelText}};
  }
  .hb-back-text {
    {{bodyFont}}
    font-size: 1.3;
    color: {{colors.panelText}};
  }
  .hb-page-title {
    {{headingFont}}
    font-size: 2.4;
    font-weight: semi-bold;
    color: {{colors.accent}};
  }
  .hb-spacer {
    width: 8;
  }

  .hb-tabs {
    flex-direction: row;
    justify-content: center;
    gap: 0.8;
    margin-top: 1.1;
    margin-bottom: 1.1;
  }
  .hb-tab {
    {{bodyFont}}
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 1.5;
    padding-right: 1.5;
    border-radius: 2;
    border-width: 0.1;
    border-color: {{colors.panelBorder}};
    font-size: 1.3;
    color: {{colors.panelText}};
    cursor: pointer;
  }
  .hb-tab:hover {
    border-color: {{colors.highlight}};
  }

  .hb-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 35.6;
    gap: 1;
  }
  .hb-tile-wrap {
    flex-direction: row;
    align-items: stretch;
    width: 17.1;
    height: 6.3;
  }
  .hb-tile {
    flex-direction: column;
    flex-grow: 1;
    padding-top: 0.7;
    padding-bottom: 0.7;
    padding-left: 1;
    padding-right: 1;
    border-radius: 1.2;
    border-width: 0.12;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }
  .hb-tile:hover {
    border-color: {{colors.accent}};
    background-color: {{colors.panelBorder}};
  }
  .hb-tile-row {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.6;
    margin-top: 0.4;
  }
  .hb-tile-name {
    {{headingFont}}
    line-height: 1.3;
    font-size: 1.35;
    font-weight: semi-bold;
    color: {{colors.panelText}};
  }
  .hb-badge {
    {{bodyFont}}
    flex-shrink: 0;
    padding-top: 0.15;
    padding-bottom: 0.15;
    padding-left: 0.7;
    padding-right: 0.7;
    border-radius: 1;
    background-color: {{colors.panelBorder}};
    font-size: 1;
    color: {{colors.accent}};
  }
  .hb-tile-sum {
    {{bodyFont}}
    line-height: 1.3;
    flex-shrink: 1;
    font-size: 1.05;
    color: {{colors.panelMuted}};
  }
  .hb-del {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 3;
    margin-left: 0.4;
    border-radius: 1;
    border-width: 0.1;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }
  .hb-del:hover {
    border-color: {{colors.reversed}};
  }
  .hb-del-icon {
    width: 1.5;
    height: 1.5;
    color: {{colors.panelMuted}};
  }
  .hb-empty {
    flex-direction: column;
    align-items: center;
    margin-top: 5;
    gap: 1.4;
  }
  .hb-note {
    {{bodyFont}}
    font-size: 1.25;
    line-height: 1.4;
    text-align: center;
    color: {{colors.panelMuted}};
  }
  .hb-button {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1.6;
    padding-right: 1.6;
    border-radius: 1.2;
    border-width: 0.12;
    border-color: {{colors.accent}};
    cursor: pointer;
  }
  .hb-button:hover {
    background-color: {{colors.panelBorder}};
  }
  .hb-button-icon {
    width: 1.6;
    height: 1.6;
    color: {{colors.accent}};
  }
  .hb-button-text {
    {{bodyFont}}
    flex-shrink: 0;
    font-size: 1.35;
    color: {{colors.accent}};
  }

  .hb-section {
    {{bodyFont}}
    margin-top: 1.1;
    margin-bottom: 0.6;
    font-size: 1.1;
    font-weight: semi-bold;
    letter-spacing: 0.15;
    color: {{colors.panelMuted}};
  }
  .hb-chips {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.8;
  }
  .hb-chip {
    flex-direction: row;
    align-items: center;
    gap: 0.5;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.1;
    padding-right: 1.1;
    border-radius: 2;
    border-width: 0.12;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }
  .hb-chip:hover {
    border-color: {{colors.highlight}};
  }
  .hb-chip-icon {
    width: 1.5;
    height: 1.5;
    color: {{colors.panelText}};
  }
  .hb-chip-text {
    {{bodyFont}}
    font-size: 1.25;
    color: {{colors.panelText}};
  }
  .hb-backs {
    flex-direction: row;
    flex-wrap: wrap;
    width: 35.6;
    gap: 0.7;
  }
  .hb-backchip {
    flex-direction: column;
    align-items: center;
    width: 8.2;
    padding-top: 0.5;
    padding-bottom: 0.5;
    border-radius: 1;
    border-width: 0.14;
    border-color: {{colors.panelBorder}};
    cursor: pointer;
  }
  .hb-backchip:hover {
    border-color: {{colors.highlight}};
  }
  .hb-backthumb {
    width: 3.9;
    height: 6.7;
    border-radius: 0.3;
  }
  .hb-backname {
    {{bodyFont}}
    line-height: 1.3;
    margin-top: 0.3;
    font-size: 0.95;
    text-align: center;
    color: {{colors.panelText}};
  }
  .hb-danger {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    margin-top: 1.6;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 1.6;
    padding-right: 1.6;
    border-radius: 1.2;
    border-width: 0.12;
    border-color: {{colors.reversed}};
    cursor: pointer;
  }
  .hb-danger:hover {
    background-color: {{colors.panelBorder}};
  }
  .hb-danger-icon {
    width: 1.6;
    height: 1.6;
    color: {{colors.reversed}};
  }
  .hb-danger-text {
    {{bodyFont}}
    font-size: 1.35;
    color: {{colors.reversed}};
  }

  .hb-steps {
    flex-direction: row;
    width: 35.6;
    gap: 1.2;
    margin-top: 1.4;
  }
  .hb-step {
    flex-direction: column;
    align-items: center;
    width: 11;
    padding-top: 1.2;
    padding-bottom: 1.2;
    padding-left: 0.9;
    padding-right: 0.9;
    border-radius: 1.4;
    border-width: 0.12;
    border-color: {{colors.panelBorder}};
  }
  .hb-step-icon {
    width: 3;
    height: 3;
    color: {{colors.accent}};
  }
  .hb-step-title {
    {{headingFont}}
    line-height: 1.3;
    margin-top: 0.6;
    font-size: 1.6;
    font-weight: semi-bold;
    color: {{colors.panelText}};
  }
  .hb-step-text {
    {{bodyFont}}
    margin-top: 0.6;
    font-size: 1.15;
    line-height: 1.4;
    text-align: center;
    color: {{colors.panelText}};
  }
  .hb-howfoot {
    flex-direction: column;
    align-items: center;
    gap: 1.2;
    margin-top: 1.4;
  }

  .hb-maker {
    {{headingFont}}
    margin-top: 1.4;
    font-size: 2;
    font-weight: semi-bold;
    text-align: center;
    color: {{colors.panelText}};
  }
  .hb-credits {
    flex-direction: row;
    flex-wrap: wrap;
    width: 35.6;
    gap: 1.1;
    margin-top: 1.4;
  }
  .hb-credit {
    flex-direction: column;
    width: 17.1;
  }
  .hb-credit-head {
    {{bodyFont}}
    font-size: 1.05;
    font-weight: semi-bold;
    letter-spacing: 0.12;
    color: {{colors.accent}};
  }
  .hb-credit-text {
    {{bodyFont}}
    line-height: 1.3;
    margin-top: 0.25;
    font-size: 1.1;
    line-height: 1.35;
    color: {{colors.panelText}};
  }
  {{slot:builderStyles}}
  {{slot:togetherStyles}}

  .hb-motto {
    {{headingFont}}
    margin-top: 1.4;
    font-size: 1.3;
    text-align: center;
    color: {{colors.panelMuted}};
  }
</style>
<div id="hub" class="hb-root">
  <!-- Home -->
  <div id="hb-home" class="hb-page">
    <div class="hb-center">
      <div class="hb-title">Carta Luna</div>
      <div class="hb-tagline">A quiet place to reflect with the cards.</div>
      <div class="hb-begin-row">
        <div id="hb-begin" class="hb-begin">
          <Sparkles class="hb-begin-icon"></Sparkles>
          <div class="hb-begin-text">Begin a reading</div>
        </div>
        <div id="hb-together-go" class="hb-together-go" style="display: none">
          <Users class="hb-together-icon"></Users>
          <div id="hb-together-text" class="hb-together-text">Read together</div>
        </div>
      </div>
      <div id="hb-newhere" class="hb-newhere" style="display: none">New here? Start with how it works</div>
      <div class="hb-tiles">
        <div id="hb-go-build" class="hb-go">
          <WandSparkles class="hb-go-icon"></WandSparkles>
          <div class="hb-go-title">Make your own</div>
          <div class="hb-go-sub">A spread of up to 12 cards</div>
        </div>
        <div id="hb-go-settings" class="hb-go">
          <Settings class="hb-go-icon"></Settings>
          <div class="hb-go-title">Settings</div>
          <div class="hb-go-sub">Card backs, deck, surroundings</div>
        </div>
        <div id="hb-go-how" class="hb-go">
          <CircleHelp class="hb-go-icon"></CircleHelp>
          <div class="hb-go-title">How it works</div>
          <div class="hb-go-sub">Pinch, lift, shake, turn</div>
        </div>
      </div>
    </div>
    <div class="hb-footer">
      <div id="hb-move" class="hb-link">
        <Move class="hb-link-icon"></Move>
        <div class="hb-link-text">Move the mat</div>
      </div>
      <div id="hb-go-credits" class="hb-link">
        <Heart class="hb-link-icon"></Heart>
        <div class="hb-link-text">Credits</div>
      </div>
    </div>
  </div>

  <!-- Spreads -->
  <div id="hb-spreads" class="hb-page" style="display: none">
    <div class="hb-head">
      <div id="hb-spreads-back" class="hb-back">
        <ArrowLeft class="hb-back-icon"></ArrowLeft>
        <div class="hb-back-text">Back</div>
      </div>
      <div class="hb-page-title">Choose a reading</div>
      <div class="hb-spacer"></div>
    </div>
    <div class="hb-tabs">
      <div id="hb-tab-classic" class="hb-tab">Classic</div>
      <div id="hb-tab-yours" class="hb-tab">Yours</div>
    </div>
    <div class="hb-grid">{{slot:spreadTiles}}</div>
    <div id="hb-yours-empty" class="hb-empty" style="display: none">
      <div class="hb-note">Spreads you make are saved here, on this headset.</div>
      <div id="hb-empty-build" class="hb-button">
        <WandSparkles class="hb-button-icon"></WandSparkles>
        <div class="hb-button-text">Make your own</div>
      </div>
    </div>
  </div>

  {{slot:builder}}

  {{slot:together}}

  <!-- Settings -->
  <div id="hb-settings" class="hb-page" style="display: none">
    <div class="hb-head">
      <div id="hb-settings-back" class="hb-back">
        <ArrowLeft class="hb-back-icon"></ArrowLeft>
        <div class="hb-back-text">Back</div>
      </div>
      <div class="hb-page-title">Settings</div>
      <div class="hb-spacer"></div>
    </div>
    <div class="hb-tabs">
      <div id="hb-st-cards" class="hb-tab">Cards</div>
      <div id="hb-st-around" class="hb-tab">Around you</div>
      <div id="hb-st-data" class="hb-tab">Your data</div>
    </div>
    <div id="hb-st-cards-body" class="hb-page">
      <div class="hb-section">CARD BACK</div>
      <div class="hb-backs">{{slot:backChips}}</div>
      <div class="hb-section">DECK</div>
      <div class="hb-chips">{{slot:deckChips}}</div>
    </div>
    <div id="hb-st-around-body" class="hb-page" style="display: none">
      <div class="hb-section">WHAT YOU SEE AROUND THE TABLE</div>
      <div class="hb-chips">{{slot:envChips}}</div>
      <div class="hb-note" style="margin-top: 3">Your own room shows through the headset's cameras. The others surround you in a quiet place of their own.</div>
    </div>
    <div id="hb-st-data-body" class="hb-page" style="display: none">
      <div class="hb-note" style="margin-top: 2">Carta Luna keeps only your settings and the spreads you make, and only on this headset. Readings are never saved, and nothing is ever sent anywhere.</div>
      <div class="hb-center">
        <div id="hb-clear" class="hb-danger">
          <Trash2 class="hb-danger-icon"></Trash2>
          <div id="hb-clear-text" class="hb-danger-text">Clear saved data</div>
        </div>
      </div>
      <div class="hb-note">Adding your own decks, card backs, and surroundings is coming in a later update.</div>
    </div>
  </div>

  <!-- How it works -->
  <div id="hb-how" class="hb-page" style="display: none">
    <div class="hb-head">
      <div id="hb-how-back" class="hb-back">
        <ArrowLeft class="hb-back-icon"></ArrowLeft>
        <div class="hb-back-text">Back</div>
      </div>
      <div class="hb-page-title">How it works</div>
      <div class="hb-spacer"></div>
    </div>
    <div class="hb-steps">
      <div class="hb-step">
        <Shuffle class="hb-step-icon"></Shuffle>
        <div class="hb-step-title">Shuffle</div>
        <div class="hb-step-text">Tap the deck to shuffle it, or lift it and give it a shake. You can shake it again between draws.</div>
      </div>
      <div class="hb-step">
        <Hand class="hb-step-icon"></Hand>
        <div class="hb-step-title">Draw</div>
        <div class="hb-step-text">Pinch the top card to take it, or tap the deck to send it to its place. Cards go out in order, and the next spot glows.</div>
      </div>
      <div class="hb-step">
        <RotateCw class="hb-step-icon"></RotateCw>
        <div class="hb-step-title">Reflect</div>
        <div class="hb-step-text">Turn your hand over to turn a card, then let go. Tap a face-up card to read it, and sit with its question.</div>
      </div>
    </div>
    <div class="hb-howfoot">
      <div class="hb-note">With controllers, the trigger pinches and the grip button lifts. From a distance, point and tap.</div>
      <div id="hb-how-done" class="hb-button">
        <Check class="hb-button-icon"></Check>
        <div class="hb-button-text">Got it</div>
      </div>
    </div>
  </div>

  <!-- Credits -->
  <div id="hb-credits" class="hb-page" style="display: none">
    <div class="hb-head">
      <div id="hb-credits-back" class="hb-back">
        <ArrowLeft class="hb-back-icon"></ArrowLeft>
        <div class="hb-back-text">Back</div>
      </div>
      <div class="hb-page-title">Credits</div>
      <div class="hb-spacer"></div>
    </div>
    <div class="hb-maker">Made by Screen Sage Studios</div>
    <div class="hb-credits">
      <div class="hb-credit">
        <div class="hb-credit-head">CARD ART</div>
        <div class="hb-credit-text">The 1909 Rider-Waite-Smith deck, drawn by Pamela Colman Smith. Public domain, scanned copies via Wikimedia Commons.</div>
      </div>
      <div class="hb-credit">
        <div class="hb-credit-head">CARD MEANINGS</div>
        <div class="hb-credit-text">Written for Carta Luna. Copyright Screen Sage Studios.</div>
      </div>
      <div class="hb-credit">
        <div class="hb-credit-head">CARD BACKS AND CLOTH</div>
        <div class="hb-credit-text">Original designs made for Carta Luna.</div>
      </div>
      <div class="hb-credit">
        <div class="hb-credit-head">TEXTURES</div>
        <div class="hb-credit-text">Stone and floor textures from Poly Haven, CC0.</div>
      </div>
      <div class="hb-credit">
        <div class="hb-credit-head">TYPE AND ICONS</div>
        <div class="hb-credit-text">Playfair Display and Inter, SIL Open Font License. Lucide icons, ISC license.</div>
      </div>
      <div class="hb-credit">
        <div class="hb-credit-head">BUILT WITH</div>
        <div class="hb-credit-text">Meta's Immersive Web SDK, three.js, and uikit. Controller models from WebXR Input Profiles, MIT license.</div>
      </div>
    </div>
    <div class="hb-motto">For reflection, never prediction.</div>
  </div>
</div>
