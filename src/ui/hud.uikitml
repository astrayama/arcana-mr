<!--
  The small panel beside the mat during a reading: what to do next, New
  reading, and Choose another (before the first shuffle).
  Theme template: double-brace tokens are filled from the active theme.
-->
<style>
  {{fontFaces}}

  .mn-root {
    flex-direction: column;
    align-items: center;
    width: 30;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2;
    padding-right: 2;
    background-color: {{colors.panelBackground}};
    border-color: {{colors.panelBorder}};
    border-width: 0.12;
    border-radius: {{panelRadius}};
  }

  .mn-status {
    {{bodyFont}}
    width: 26;
    font-size: 1.4;
    line-height: 1.35;
    text-align: center;
    color: {{colors.panelText}};
  }

  .mn-primary {
    flex-direction: row;
    align-items: center;
    gap: 0.6;
    margin-top: 1.6;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 3;
    padding-right: 3;
    border-radius: 1.2;
    background-color: {{colors.accent}};
    cursor: pointer;
  }

  .mn-primary:hover {
    background-color: {{colors.highlight}};
  }

  .mn-primary-icon {
    width: 1.9;
    height: 1.9;
    color: {{colors.accentText}};
  }

  .mn-primary-text {
    {{bodyFont}}
    font-size: 1.6;
    font-weight: semi-bold;
    color: {{colors.accentText}};
  }

  .mn-link {
    flex-direction: row;
    align-items: center;
    gap: 0.5;
    margin-top: 1.2;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 1.2;
    padding-right: 1.2;
    border-radius: 1;
    cursor: pointer;
  }

  .mn-link:hover {
    background-color: {{colors.panelBorder}};
  }

  .mn-link-icon {
    width: 1.6;
    height: 1.6;
    color: {{colors.panelMuted}};
  }

  .mn-link-text {
    {{bodyFont}}
    font-size: 1.3;
    color: {{colors.panelMuted}};
  }
</style>
<div id="menu" class="mn-root">
  <div id="mn-status" class="mn-status">Shuffle the deck.</div>
  <div id="mn-new" class="mn-primary">
    <RotateCcw class="mn-primary-icon"></RotateCcw>
    <div class="mn-primary-text">New reading</div>
  </div>
  <div id="mn-another" class="mn-link" style="display: none">
    <ArrowLeft class="mn-link-icon"></ArrowLeft>
    <div class="mn-link-text">Choose another reading</div>
  </div>
</div>
