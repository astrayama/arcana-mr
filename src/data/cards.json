    "name": "Four of Pentacles",
    "arcana": "minor",
    "suit": "pentacles",
    "number": 4,
    "upright": {
      "keywords": [
        "holding on",
        "security",
        "control"
      ],
      "read": "The Four of Pentacles is about gripping what you have, whether that is money, time, energy, or a sense of control. There is wisdom in protecting what matters. The question is whether your grip is keeping you safe or keeping you small.",
      "prompt": "What are you holding tightly right now, and what do you fear would happen if you loosened your grip?"
    },
    "reversed": {
      "keywords": [
        "loosening",
        "generosity",
        "scarcity"
      ],
      "read": "Reversed, this card can go two ways: you may be learning to loosen your grip and share more freely, or a sense of scarcity may have you spending, giving, or saying yes more than feels steady. Notice which one fits. Both are worth being honest about.",
      "prompt": "Where in your life does giving feel generous, and where does it feel like leaking?"
    }
  },
