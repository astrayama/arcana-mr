  {
    "id": "major-16-the-tower",
    "name": "The Tower",
    "arcana": "major",
    "suit": null,
    "number": 16,
    "upright": {
      "keywords": [
        "sudden change",
        "revelation",
        "clearing out"
      ],
      "read": "The Tower marks a moment when something built on shaky ground stops holding. It can feel like shock, but it often clears space for what is true. Notice which structures in your life you have been propping up out of habit.",
      "prompt": "What are you holding together that you already suspect cannot last?"
    },
    "reversed": {
      "keywords": [
        "resisting change",
        "slow unraveling",
        "private reckoning"
      ],
      "read": "Reversed, The Tower suggests the shake-up is happening on the inside, or that you are bracing hard to keep it from happening at all. Sometimes the collapse we avoid simply arrives more slowly. This card asks you to look at the cost of holding the walls up.",
      "prompt": "What change are you working hard to postpone, and what is that effort costing you?"
    }
  },
  {
    "id": "major-17-the-star",
    "name": "The Star",
    "arcana": "major",
    "suit": null,
    "number": 17,
    "upright": {
      "keywords": [
        "hope",
        "renewal",
        "quiet trust"
      ],
      "read": "After a hard stretch, The Star shows up like the first clear night. It points to the part of you that is still willing to hope, even a little, and to the small ways you are already healing. Nothing here has to be rushed.",
      "prompt": "What small sign of renewal have you noticed in yourself lately, even if it felt too quiet to count?"
    },
    "reversed": {
      "keywords": [
        "discouragement",
        "disconnection",
        "running on empty"
      ],
      "read": "Reversed, The Star can appear when hope feels far away or when you have stopped expecting good things for yourself. It is less a verdict than a check-in: notice where you might be withholding care from yourself, or waiting for permission to feel better.",
      "prompt": "Where have you stopped looking after yourself, and what would one gentle step back toward that look like?"
    }
  },
