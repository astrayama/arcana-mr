  {
    "id": "cups-queen",
    "name": "Queen of Cups",
    "arcana": "minor",
    "suit": "cups",
    "number": 13,
    "upright": {
      "keywords": [
        "compassion",
        "emotional depth",
        "intuition"
      ],
      "read": "The Queen of Cups feels things fully and does not apologize for it. She points to your capacity to hold your own emotions, and other people's, without drowning in them. Notice where your intuition has been quietly right.",
      "prompt": "When you listen underneath the noise, what are your feelings trying to tell you right now?"
    },
    "reversed": {
      "keywords": [
        "overwhelm",
        "blurred boundaries",
        "self-neglect"
      ],
      "read": "Reversed, the Queen of Cups can point to caring so much for others that your own inner life goes unattended. Or it can show feelings you have kept at arm's length because they seem like too much. Either way, try turning some of that tenderness toward yourself.",
      "prompt": "Whose feelings have you been carrying that are not yours to hold?"
    }
  },
