    "id": "swords-eight",
    "name": "Eight of Swords",
    "arcana": "minor",
    "suit": "swords",
    "number": 8,
    "upright": {
      "keywords": [
        "feeling stuck",
        "self-imposed limits",
        "fear"
      ],
      "read": "The Eight of Swords describes the feeling of being trapped, often by fears and stories more than by real walls. It points to places where you may have more room to move than you think. Notice which of your limits are facts and which are assumptions.",
      "prompt": "What would you try if you trusted that the way out is more open than it looks?"
    },
    "reversed": {
      "keywords": [
        "release",
        "new perspective",
        "taking back power"
      ],
      "read": "Reversed, the Eight of Swords suggests a loosening. You may be seeing a situation more clearly, or noticing that the rules you were following were never really yours. That clarity can feel exposing before it feels freeing.",
      "prompt": "Which old rule about what you are allowed to want is ready to be questioned?"
    }
  },
